@page "/counter"
@rendermode InteractiveServer

<PageTitle>Adan Test Project</PageTitle>

<h1>Counter</h1>

<p role="status"> counting values by clicking: @adanCounter</p>

<button class="btn btn-primary" @onclick="IncrementCount">press me</button>

@code {
    private int adanCounter = 0;

    private void IncrementCount()
    {
        adanCounter++;
    }
}
