@page "/counter"
@rendermode InteractiveServer

<PageTitle>Adan Test Project</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @adanCounter</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int adanCounter = 0;

    private void IncrementCount()
    {
        adanCounter++;
    }
}
